---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Page Not Found"
  description="That page does not exist. Head back to the PhotoPop home page or get a quote for your event."
  noindex={true}
>
  <section class="container-page max-w-xl py-24 text-center">
    <span
      class="inline-flex h-20 w-20 items-center justify-center rounded-2xl bg-brand-50 text-brand-500"
    >
      <Icon name="camera" size={40} strokeWidth={1.5} />
    </span>

    <p class="mt-8 font-display text-6xl font-extrabold text-brand-500">404</p>
    <h1 class="mt-3 text-3xl text-ink">This shot didn't develop</h1>
    <p class="mt-4 leading-relaxed text-ink-soft">
      The page you were after has moved or never existed. No harm done — here is
      the way back.
    </p>

    <div class="mt-9 flex flex-col justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/book" class="btn-outline">Get a quote</a>
    </div>

    <div class="mt-12 border-t border-slate-200 pt-8">
      <p class="text-sm text-ink-muted">Or try one of these</p>
      <nav class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm font-semibold">
        <a href="/packages" class="text-brand-600 hover:text-brand-700">Packages</a>
        <a href="/gallery" class="text-brand-600 hover:text-brand-700">Gallery</a>
        <a href="/about" class="text-brand-600 hover:text-brand-700">About</a>
        <a href="/faq" class="text-brand-600 hover:text-brand-700">FAQ</a>
      </nav>
    </div>
  </section>
</BaseLayout>
