---
import { config } from '../lib/config';
import Icon from './Icon.astro';

const links = [
  { href: '/', label: 'Home' },
  { href: '/packages', label: 'Packages' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/about', label: 'About' },
  { href: '/faq', label: 'FAQ' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

{/* Solid white, not translucent: the logo artwork has a white ground, and a
    see-through header turns grey over dark sections and exposes it as a box. */}
<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white">
  <div class="container-page flex h-18 items-center justify-between gap-4 py-3">
    <a href="/" class="flex shrink-0 items-center" aria-label={`${config.site.name} home`}>
      {/* 393x132 file shown 44-48px tall — ~3x density for sharp phone screens. */}
      <img
        src={config.assets.logo}
        alt={config.site.name}
        width="393"
        height="132"
        fetchpriority="high"
        class="h-11 w-auto sm:h-12"
      />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-4 py-2 text-sm font-semibold transition-colors',
              isActive(link.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-ink-soft hover:bg-slate-100 hover:text-ink',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <a href="/book" class="btn-accent hidden px-6 py-2.5 text-sm sm:inline-flex">
        Get a Quote
      </a>

      <button
        type="button"
        id="menu-toggle"
        class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-slate-200 text-ink lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={22} data-menu-open />
        <Icon name="x" size={22} class="hidden" data-menu-close />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden">
    <nav class="container-page flex flex-col gap-1 py-4" aria-label="Mobile">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-xl px-4 py-3 text-base font-semibold',
              isActive(link.href)
                ? 'bg-brand-50 text-brand-700'
                : 'text-ink-soft hover:bg-slate-50',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a href="/book" class="btn-accent mt-2 w-full">Get a Quote</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const openIcon = toggle.querySelector('[data-menu-open]');
    const closeIcon = toggle.querySelector('[data-menu-close]');

    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Open menu' : 'Close menu');
      menu.classList.toggle('hidden', isOpen);
      openIcon?.classList.toggle('hidden', !isOpen);
      closeIcon?.classList.toggle('hidden', isOpen);
    });
  }
</script>
