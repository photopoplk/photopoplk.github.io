---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, subtitle, align = 'center' } = Astro.props;
---

<section class="border-b border-slate-200 bg-gradient-to-b from-brand-50 to-white">
  <div
    class:list={[
      'container-page py-14 sm:py-18',
      align === 'center' ? 'mx-auto max-w-3xl text-center' : '',
    ]}
  >
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="text-4xl leading-tight text-ink sm:text-5xl">{title}</h1>
    {
      subtitle && (
        <p
          class:list={[
            'mt-4 text-lg leading-relaxed text-ink-soft',
            align === 'center' ? 'mx-auto max-w-2xl' : 'max-w-2xl',
          ]}
        >
          {subtitle}
        </p>
      )
    }
    <slot />
  </div>
</section>
