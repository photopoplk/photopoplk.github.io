---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import PricingCard from '../components/PricingCard.astro';
import AddonCard from '../components/AddonCard.astro';
import FaqItem from '../components/FaqItem.astro';
import CtaSection from '../components/CtaSection.astro';
import Icon from '../components/Icon.astro';
import { config } from '../lib/config';
import type { ComparisonValue } from '../lib/config';

const packages = config.pricing.packages;
const columns = ['silver', 'gold', 'platinum', 'diamond'] as const;

const quickFaqs = [
  {
    q: 'Can I customise a package?',
    a: 'Yes. Every package is a starting point — mix in add-ons, adjust the hours, or tell us what you need and we will build a quote around it.',
  },
  {
    q: 'Do you provide props?',
    a: 'A full prop box is included with every package, refreshed regularly. If your event has a theme, tell us and we will match it.',
  },
  {
    q: 'What happens if it rains?',
    a: 'The booth is best under cover. For outdoor venues we plan a sheltered spot with you in advance, and can pause safely if the weather turns.',
  },
  {
    q: 'How far in advance should I book?',
    a: 'Wedding season fills up first. Four to six weeks ahead is comfortable, but ask us about short-notice dates — we often have them.',
  },
];
---

<BaseLayout
  title="Photo Booth Packages & Pricing"
  description="Photo booth packages for weddings, corporate events and parties in Sri Lanka. Four tiers from LKR 25,000, plus add-ons like custom branding, 360 video and live social display."
  keywords="photo booth packages Sri Lanka, photo booth pricing Colombo, wedding photo booth prices, corporate photo booth rental"
>
  <PageHeader
    eyebrow="Packages"
    title="Event packages for every celebration"
    subtitle="Four tiers to start from, and a custom quote for anything in between. Setup, teardown and props are always included."
  />

  {/* ------------------------------------------------------- Pricing cards */}
  <section class="container-page py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {packages.map((pkg) => <PricingCard pkg={pkg} />)}
    </div>
    <p class="mt-8 text-center text-sm text-ink-muted">{config.pricing.note}</p>
  </section>

  {/* --------------------------------------------------- Comparison matrix */}
  <section class="bg-slate-50 py-20">
    <div class="container-page">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <p class="eyebrow mb-3">Compare</p>
        <h2 class="text-3xl text-ink sm:text-4xl">What's in each package</h2>
      </div>

      {/* Desktop: comparison table */}
      <div class="hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white lg:block">
        <table class="w-full border-collapse text-left text-sm">
          <caption class="sr-only">
            Feature comparison across the Silver, Gold, Platinum and Diamond
            packages
          </caption>
          <thead>
            <tr class="border-b border-slate-200 bg-slate-50">
              <th scope="col" class="px-6 py-4 font-display text-ink">Feature</th>
              {
                packages.map((pkg) => (
                  <th scope="col" class="px-6 py-4 text-center font-display text-ink">
                    {pkg.name}
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              config.comparison.map((row) => (
                <tr class="border-b border-slate-100 last:border-0">
                  <th scope="row" class="px-6 py-3.5 font-medium text-ink-soft">
                    {row.feature}
                  </th>
                  {columns.map((col) => {
                    const value: ComparisonValue = row[col];
                    return (
                      <td class="px-6 py-3.5 text-center">
                        {value === true ? (
                          <>
                            <Icon
                              name="check"
                              size={18}
                              class="mx-auto text-brand-500"
                              strokeWidth={2.5}
                            />
                            <span class="sr-only">Included</span>
                          </>
                        ) : value === false ? (
                          <>
                            <span class="text-slate-300" aria-hidden="true">
                              —
                            </span>
                            <span class="sr-only">Not included</span>
                          </>
                        ) : (
                          <span class="text-xs font-semibold text-accent-600">{value}</span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      {/* Mobile: one card per package instead of a scrolling table */}
      <div class="space-y-4 lg:hidden">
        {
          packages.map((pkg, i) => (
            <details class="group rounded-2xl border border-slate-200 bg-white" open={i === 1}>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-5 font-display font-medium text-ink">
                <span>
                  {pkg.name}
                </span>
                <Icon
                  name="chevron"
                  size={18}
                  class="shrink-0 text-brand-500 transition-transform group-open:rotate-180"
                />
              </summary>
              <ul class="space-y-2.5 border-t border-slate-100 px-5 py-4 text-sm">
                {config.comparison.map((row) => {
                  const value: ComparisonValue = row[columns[i]];
                  return (
                    <li class="flex items-start justify-between gap-4">
                      <span class={value === false ? 'text-slate-400' : 'text-ink-soft'}>
                        {row.feature}
                      </span>
                      <span class="shrink-0">
                        {value === true ? (
                          <Icon name="check" size={16} class="text-brand-500" strokeWidth={2.5} />
                        ) : value === false ? (
                          <span class="text-slate-300">—</span>
                        ) : (
                          <span class="text-xs font-semibold text-accent-600">{value}</span>
                        )}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  {/* -------------------------------------------------------------- Add-ons */}
  <section class="container-page py-20">
    <div class="mx-auto mb-12 max-w-2xl text-center">
      <p class="eyebrow mb-3">Add-ons</p>
      <h2 class="text-3xl text-ink sm:text-4xl">Make it yours</h2>
      <p class="mt-4 leading-relaxed text-ink-soft">
        Bolt any of these onto any package. Mention them in your quote request
        and we will price them in.
      </p>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {config.addons.map((addon) => <AddonCard addon={addon} />)}
    </div>
  </section>

  {/* ------------------------------------------------------------ Quick FAQ */}
  <section class="bg-slate-50 py-20">
    <div class="container-page max-w-3xl">
      <div class="mb-8 text-center">
        <p class="eyebrow mb-3">Before you ask</p>
        <h2 class="text-3xl text-ink sm:text-4xl">Quick answers</h2>
      </div>

      <div class="rounded-2xl border border-slate-200 bg-white px-6">
        {quickFaqs.map((item) => <FaqItem question={item.q}>{item.a}</FaqItem>)}
      </div>

      <div class="mt-8 text-center">
        <a href="/faq" class="btn-outline">
          See all FAQs
          <Icon name="arrow" size={16} />
        </a>
      </div>
    </div>
  </section>

  <CtaSection
    title="Not sure which package fits?"
    subtitle="Tell us the date, the venue and roughly how many guests. We will recommend the right tier — and say so if a smaller one will do."
  />
</BaseLayout>
