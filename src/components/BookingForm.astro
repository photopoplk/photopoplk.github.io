---
/**
 * The /book quote form. Drawn from `booking.form_sections` in config.yaml and
 * submitted straight into the Google Form, so every answer still lands in the
 * form's Responses tab, its linked Sheet and the notification emails.
 *
 * How the submit works: the browser POSTs the answers to Google's own
 * `formResponse` address using the form's `entry.<id>` field names. Google
 * does not let other sites read its reply, so the page checks every answer
 * itself first, then treats a delivered request as success and moves on to
 * /thank-you. With JavaScript off, the form still posts normally and the
 * visitor sees Google's confirmation message instead.
 */
import Icon from './Icon.astro';
import { config, googleFormActionUrl, whatsappLink, hasRealPhone } from '../lib/config';
import type { FormField } from '../lib/config';

const action = googleFormActionUrl();
const sections = config.booking.form_sections ?? [];
const showWhatsApp = hasRealPhone();

// Google Forms needs to be told which of its sections the visitor "went
// through". The sections in config.yaml mirror the Google Form's, so this is
// 0,1,2 for a three-section form.
const pageHistory = sections.map((_, i) => i).join(',');

// /book?package=gold → the option that starts with "Gold", e.g. "Gold (3 hrs)".
function packagePrefillMap(field: FormField): Record<string, string> {
  const map: Record<string, string> = {};
  for (const pkg of config.pricing.packages) {
    const match = field.options?.find((o) =>
      o.toLowerCase().startsWith(pkg.name.toLowerCase())
    );
    if (match) map[pkg.id] = match;
  }
  return map;
}

const name = (f: FormField) => `entry.${f.entry}`;
const id = (f: FormField) => `f-${f.entry}`;

const inputClass =
  'mt-2 block w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-[0.95rem] text-ink placeholder:text-ink-muted/70 transition-colors focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-500/20 aria-[invalid=true]:border-red-500';
const pillClass =
  'inline-flex cursor-pointer select-none items-center gap-2 rounded-full border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-ink-soft transition-colors hover:border-brand-400 peer-checked:border-brand-600 peer-checked:bg-brand-600 peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-500';
---

{
  action && (
    <form
      id="booking-form"
      action={action}
      method="POST"
      class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-9"
      data-booking-form
    >
      <input type="hidden" name="pageHistory" value={pageHistory} />
      <input type="hidden" name="fvv" value="1" />

      {/* Spam trap: invisible to people, tempting to bots. Has no name, so it
          is never sent to Google even if filled. */}
      <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
        <label for="bf-website">Website</label>
        <input id="bf-website" type="text" tabindex="-1" autocomplete="off" data-honeypot />
      </div>

      <p class="text-sm text-ink-muted">
        Fields marked <span class="text-brand-600">*</span> are required.
      </p>

      {sections.map((section, si) => (
        <div class:list={[si === 0 ? 'mt-6' : 'mt-10 border-t border-slate-200 pt-9']}>
        <fieldset>
          <legend class="flex items-center gap-3 font-display text-xl font-medium text-ink">
            <span class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-50 text-sm text-brand-600">
              {si + 1}
            </span>
            {section.title}
          </legend>

          <div class="mt-6 space-y-7">
            {section.fields.map((field) => {
              const errId = `${id(field)}-err`;
              const helpId = field.help ? `${id(field)}-help` : undefined;
              const describedBy = [helpId, errId].filter(Boolean).join(' ');
              const isChoice = field.type === 'radio' || field.type === 'checkbox';

              const Label = (
                <>
                  {field.label}
                  {field.required && <span class="text-brand-600"> *</span>}
                </>
              );

              return isChoice ? (
                <fieldset
                  data-field
                  data-choice={field.type}
                  data-required={field.required ? 'true' : undefined}
                  data-prefill={field.prefill}
                  data-prefill-map={
                    field.prefill === 'package'
                      ? JSON.stringify(packagePrefillMap(field))
                      : undefined
                  }
                  aria-describedby={describedBy}
                >
                  <legend class="text-[0.95rem] font-medium text-ink">{Label}</legend>
                  {field.help && (
                    <p id={helpId} class="mt-1 text-sm text-ink-muted">{field.help}</p>
                  )}
                  <div class="mt-3 flex flex-wrap gap-2.5">
                    {field.options?.map((opt, oi) => (
                      <label class="relative">
                        <input
                          type={field.type}
                          name={name(field)}
                          value={opt}
                          id={`${id(field)}-${oi}`}
                          required={field.type === 'radio' && field.required}
                          class="peer sr-only"
                        />
                        <span class={pillClass}>{opt}</span>
                      </label>
                    ))}
                    {field.other && (
                      <label class="relative">
                        <input
                          type={field.type}
                          name={name(field)}
                          value="__other_option__"
                          required={field.type === 'radio' && field.required}
                          class="peer sr-only"
                          data-other-toggle
                        />
                        <span class={pillClass}>Other…</span>
                      </label>
                    )}
                  </div>
                  {field.other && (
                    <div class="hidden" data-other-box>
                      <label for={`${id(field)}-other`} class="sr-only">
                        {field.label} — other
                      </label>
                      <input
                        type="text"
                        id={`${id(field)}-other`}
                        name={`${name(field)}.other_option_response`}
                        placeholder="Tell us more"
                        class={inputClass}
                        disabled
                      />
                    </div>
                  )}
                  <p id={errId} class="mt-2 hidden text-sm text-red-600" data-error />
                </fieldset>
              ) : (
                <div data-field>
                  <label for={id(field)} class="block text-[0.95rem] font-medium text-ink">
                    {Label}
                  </label>
                  {field.help && (
                    <p id={helpId} class="mt-1 text-sm text-ink-muted">{field.help}</p>
                  )}
                  {field.type === 'textarea' ? (
                    <textarea
                      id={id(field)}
                      name={name(field)}
                      rows="4"
                      required={field.required}
                      aria-describedby={describedBy}
                      class={inputClass}
                    />
                  ) : (
                    <input
                      id={id(field)}
                      name={name(field)}
                      type={field.type}
                      required={field.required}
                      autocomplete={field.autocomplete}
                      inputmode={field.type === 'tel' ? 'tel' : undefined}
                      pattern={field.type === 'tel' ? '[\\d\\s\\(\\)\\+\\-]{7,}' : undefined}
                      aria-describedby={describedBy}
                      data-date={field.type === 'date' ? 'true' : undefined}
                      class:list={[inputClass, field.type === 'date' && 'sm:max-w-xs']}
                    />
                  )}
                  <p id={errId} class="mt-2 hidden text-sm text-red-600" data-error />
                </div>
              );
            })}
          </div>
        </fieldset>
        </div>
      ))}

      <div
        class="mt-9 hidden rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-800"
        role="alert"
        data-send-error
      >
        <p class="font-medium">We couldn't send your request.</p>
        <p class="mt-1">
          Please check your connection and try again — your answers are still here.
          Or reach us directly:{' '}
          {showWhatsApp && (
            <>
              <a href={whatsappLink()} target="_blank" rel="noopener" class="font-semibold underline">
                WhatsApp
              </a>{' '}
              or{' '}
            </>
          )}
          <a href={`mailto:${config.contact.bookings_email}`} class="font-semibold underline">
            {config.contact.bookings_email}
          </a>
          .
        </p>
      </div>

      <div class="mt-9 flex flex-col items-center gap-3 border-t border-slate-200 pt-8 sm:flex-row sm:justify-between">
        <p class="flex items-center gap-2 text-sm text-ink-muted">
          <Icon name="check-circle" size={17} class="text-brand-500" />
          {config.booking.promise}
        </p>
        <button type="submit" class="btn-accent w-full sm:w-auto" data-submit>
          <span data-submit-label>Get my quote</span>
        </button>
      </div>
    </form>
  )
}

<script>
  const SUCCESS_URL = '/thank-you';
  const TIMEOUT_MS = 15000;

  function messageFor(el: HTMLInputElement | HTMLTextAreaElement): string {
    const v = el.validity;
    if (v.valueMissing) {
      return el.type === 'radio' ? 'Please choose one.' : 'Please fill this in.';
    }
    if (el.type === 'email') return 'Please enter a valid email address, e.g. name@example.com.';
    if (el.type === 'tel') return 'Please enter a phone number, with the country code.';
    if (v.rangeUnderflow) return 'Please choose a date from today onwards.';
    return el.validationMessage;
  }

  function setError(field: HTMLElement, message: string) {
    const err = field.querySelector<HTMLElement>('[data-error]');
    if (err) {
      err.textContent = message;
      err.classList.toggle('hidden', !message);
    }
    field
      .querySelectorAll<HTMLElement>('input:not([type=hidden]), textarea')
      .forEach((el) => el.setAttribute('aria-invalid', message ? 'true' : 'false'));
  }

  /** Returns the first invalid field, or null when every answer is fine. */
  function validate(form: HTMLFormElement): HTMLElement | null {
    let first: HTMLElement | null = null;
    form.querySelectorAll<HTMLElement>('[data-field]').forEach((field) => {
      let message = '';
      const controls = field.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
        'input:not([disabled]), textarea:not([disabled])'
      );
      for (const el of controls) {
        if (!el.checkValidity()) {
          message = messageFor(el);
          break;
        }
      }
      // A ticked "Other" needs its text box filled in, as Google requires.
      const other = field.querySelector<HTMLInputElement>('[data-other-toggle]');
      const otherText = field.querySelector<HTMLInputElement>('[data-other-box] input');
      if (!message && other?.checked && otherText && !otherText.value.trim()) {
        message = 'Please tell us what "Other" means here.';
      }
      setError(field, message);
      if (message && !first) first = field;
    });
    return first;
  }

  /** Turns the form into the exact fields Google's formResponse expects. */
  function payload(form: HTMLFormElement): URLSearchParams {
    const data = new FormData(form);
    // Google takes dates as three fields: entry.N_year / _month / _day.
    form.querySelectorAll<HTMLInputElement>('[data-date]').forEach((el) => {
      data.delete(el.name);
      const [y, m, d] = el.value.split('-');
      if (y && m && d) {
        data.append(`${el.name}_year`, y);
        data.append(`${el.name}_month`, String(Number(m)));
        data.append(`${el.name}_day`, String(Number(d)));
      }
    });
    const params = new URLSearchParams();
    for (const [key, value] of data) {
      if (typeof value === 'string' && value.trim() !== '') params.append(key, value.trim());
    }
    return params;
  }

  function setupOtherBoxes(form: HTMLFormElement) {
    form.querySelectorAll<HTMLElement>('[data-choice]').forEach((group) => {
      const toggle = group.querySelector<HTMLInputElement>('[data-other-toggle]');
      const box = group.querySelector<HTMLElement>('[data-other-box]');
      const text = box?.querySelector<HTMLInputElement>('input');
      if (!toggle || !box || !text) return;
      const sync = () => {
        box.classList.toggle('hidden', !toggle.checked);
        text.disabled = !toggle.checked;
        if (toggle.checked && document.activeElement === toggle) text.focus();
      };
      group.addEventListener('change', sync);
      sync();
    });
  }

  function prefillFromUrl(form: HTMLFormElement) {
    const pkg = new URLSearchParams(location.search).get('package');
    if (!pkg) return;
    const group = form.querySelector<HTMLElement>('[data-prefill="package"]');
    let map: Record<string, string> = {};
    try {
      map = JSON.parse(group?.dataset.prefillMap ?? '{}');
    } catch {
      return;
    }
    const label = map[pkg.toLowerCase()];
    if (!group || !label) return;
    group
      .querySelectorAll<HTMLInputElement>('input[type=radio]')
      .forEach((r) => (r.checked = r.value === label));
  }

  function init() {
    const form = document.querySelector<HTMLFormElement>('[data-booking-form]');
    if (!form || form.dataset.ready) return;
    form.dataset.ready = 'true';
    form.noValidate = true; // our messages replace the browser's bubbles

    // No past dates. Set here, not at build time, so it is always today.
    const now = new Date();
    const today = new Date(now.getTime() - now.getTimezoneOffset() * 60000)
      .toISOString()
      .slice(0, 10);
    form.querySelectorAll<HTMLInputElement>('[data-date]').forEach((el) => (el.min = today));

    setupOtherBoxes(form);
    prefillFromUrl(form);

    // Clear a field's error as soon as it is answered.
    form.addEventListener('change', (e) => {
      const field = (e.target as HTMLElement).closest<HTMLElement>('[data-field]');
      if (field && field.querySelector('[data-error]:not(.hidden)')) validate(form);
    });

    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-submit-label]')!;
    const sendError = form.querySelector<HTMLElement>('[data-send-error]')!;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      sendError.classList.add('hidden');

      const invalid = validate(form);
      if (invalid) {
        invalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        invalid.querySelector<HTMLElement>('input:not([disabled]), textarea')?.focus({
          preventScroll: true,
        });
        return;
      }

      // Bots fill the hidden field; send them on without bothering Google.
      const honeypot = form.querySelector<HTMLInputElement>('[data-honeypot]');
      if (honeypot?.value) {
        location.assign(SUCCESS_URL);
        return;
      }

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      label.textContent = 'Sending…';

      const controller = new AbortController();
      const timer = setTimeout(() => controller.abort(), TIMEOUT_MS);
      try {
        // `no-cors`: Google accepts the answers but hides its reply, so a
        // delivered request is the success signal.
        await fetch(form.action, {
          method: 'POST',
          mode: 'no-cors',
          body: payload(form),
          signal: controller.signal,
        });
        try {
          const nameInput = form.querySelector<HTMLInputElement>('input[autocomplete=name]');
          const first = nameInput?.value.trim().split(/\s+/)[0];
          if (first) sessionStorage.setItem('photopop:first-name', first);
        } catch {
          /* storage blocked — the thank-you page works without it */
        }
        location.assign(SUCCESS_URL);
      } catch {
        sendError.classList.remove('hidden');
        sendError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        button.disabled = false;
        button.removeAttribute('aria-busy');
        label.textContent = 'Try again';
      } finally {
        clearTimeout(timer);
      }
    });
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
